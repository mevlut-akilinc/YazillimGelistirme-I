erDiagram
    USERS {
        int id PK
        varchar username UK
        varchar password_hash "BCrypt"
        varchar full_name
        varchar role "Egitmen | Ogrenci"
        varchar student_number UK "Ogrenci ise zorunlu"
        varchar class_name
        timestamp created_at
    }
    CATEGORIES {
        int id PK
        varchar name UK
    }
    QUESTIONS {
        int id PK
        int category_id FK
        varchar type "CoktanSecmeli | Klasik | Kodlama"
        text body
        int default_points "> 0"
        text expected_answer
        text starter_code
        varchar expected_time_complexity "O1 | OLogN | ON | ONLogN | ON2 | ON3 | O2N"
        varchar expected_space_complexity "aynı değerler"
        int created_by FK
        timestamp created_at
        boolean is_deleted "soft delete"
    }
    QUESTION_OPTIONS {
        int id PK
        int question_id FK
        char label "A-E, soru içinde UNIQUE (deferrable)"
        text body
        boolean is_correct
    }
    TEST_CASES {
        int id PK
        int question_id FK
        text input
        text expected_output
        boolean is_hidden
    }
    EXAMS {
        int id PK
        varchar title
        varchar class_name
        int duration_minutes "> 0"
        varchar status "Taslak | Yayinda | Bitti"
        double test_case_weight "toplam = 1"
        double complexity_weight
        timestamp started_at
        int created_by FK
        timestamp created_at
    }
    EXAM_QUESTIONS {
        int exam_id PK, FK
        int question_id PK, FK
        int order_no
        int points "> 0"
    }
    SUBMISSIONS {
        int id PK
        int exam_id FK "UNIQUE (exam_id, student_id)"
        int student_id FK
        timestamp submitted_at
        varchar client_ip
        int earned_points
        int max_points
        int correct_count
        int graded_count
        double score "100 üzerinden"
    }
    ANSWERS {
        int id PK
        int submission_id FK "UNIQUE (submission_id, question_id)"
        int question_id FK
        int selected_option_id FK "nullable"
        text answer_text
        text code
        boolean is_correct
        int earned_points
        boolean is_pending "kodlama: finalde"
    }
    CODE_RESULTS {
        int answer_id PK, FK
        boolean compiled
        text compiler_output
        int passed_tests
        int total_tests
        varchar measured_time
        varchar measured_space
    }
    LOGS {
        bigint id PK
        int exam_id FK "nullable"
        timestamp created_at
        varchar level "Bilgi | Uyari | Hata"
        varchar source
        text message
    }

    CATEGORIES ||--o{ QUESTIONS : "içerir"
    USERS |o--o{ QUESTIONS : "oluşturur"
    QUESTIONS ||--o{ QUESTION_OPTIONS : "şıkları"
    QUESTIONS ||--o{ TEST_CASES : "testleri"
    USERS |o--o{ EXAMS : "hazırlar"
    EXAMS ||--o{ EXAM_QUESTIONS : "içerir"
    QUESTIONS ||--o{ EXAM_QUESTIONS : "kullanılır"
    EXAMS ||--o{ SUBMISSIONS : "alır"
    USERS ||--o{ SUBMISSIONS : "gönderir"
    SUBMISSIONS ||--o{ ANSWERS : "içerir"
    QUESTIONS ||--o{ ANSWERS : "cevaplanır"
    QUESTION_OPTIONS |o--o{ ANSWERS : "seçilir"
    ANSWERS ||--o| CODE_RESULTS : "kod sonucu"
    EXAMS |o--o{ LOGS : "kayıt"
