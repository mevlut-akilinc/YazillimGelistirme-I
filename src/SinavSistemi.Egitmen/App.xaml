<Application x:Class="SinavSistemi.Egitmen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SinavSistemi.Egitmen.ViewModels"
             xmlns:v="clr-namespace:SinavSistemi.Egitmen.Views"
             StartupUri="Views/LoginWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Ortak tema + converter'lar (SinavSistemi.Shared) -->
                <ResourceDictionary Source="pack://application:,,,/SinavSistemi.Shared;component/Themes/Theme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View eşlemesi -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:QuestionBankViewModel}"><v:QuestionBankView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExamBuilderViewModel}"><v:ExamBuilderView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LiveExamViewModel}"><v:LiveExamView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ResultsViewModel}"><v:ResultsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}"><v:LogsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
