<UserControl x:Class="SinavSistemi.Egitmen.Views.ResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Sonuçlar" Style="{StaticResource H1}"/>
                <TextBlock Text="Öğrenci bazında puanlar ve sınıf istatistikleri" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding Exams}" SelectedItem="{Binding SelectedExam}" DisplayMemberPath="Title" Width="300" Margin="0,0,10,0"/>
                <Button Content="CSV olarak dışa aktar" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>

        <UniformGrid DockPanel.Dock="Top" Columns="5" Margin="0,0,-16,16">
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="KATILIM" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Participants}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="SINIF ORTALAMASI" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Average}" Style="{StaticResource StatNumber}" Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="EN YÜKSEK" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Highest}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="EN DÜŞÜK" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding Lowest}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                <StackPanel>
                    <TextBlock Text="ORT. DOĞRU" Style="{StaticResource FieldLabel}"/>
                    <TextBlock Text="{Binding AvgCorrect}" Style="{StaticResource StatNumber}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ÖĞRENCİ NO" Binding="{Binding StudentNumber}" Width="110"/>
                    <DataGridTextColumn Header="AD SOYAD" Binding="{Binding FullName}" Width="*"/>
                    <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="70"/>
                    <DataGridTemplateColumn Header="DOĞRU" Width="90" SortMemberPath="CorrectCount">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding CorrectCount, Mode=OneWay}"/> / <Run Text="{Binding TotalQuestions, Mode=OneWay}"/>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="PUAN" Width="160" SortMemberPath="Score">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Score, StringFormat=0.0}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ProgressBar Grid.Column="1" Value="{Binding Score, Mode=OneWay}" Maximum="100" Height="6"
                                                 Foreground="{StaticResource AccentBrush}" Background="{StaticResource BgBrush}"
                                                 BorderThickness="0" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="ZAMAN K." Binding="{Binding TimeComplexity}" Width="100"/>
                    <DataGridTextColumn Header="YER K." Binding="{Binding SpaceComplexity}" Width="80"/>
                    <DataGridTextColumn Header="TESLİM" Binding="{Binding SubmittedAt, StringFormat=HH:mm:ss}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
