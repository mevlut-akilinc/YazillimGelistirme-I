<UserControl x:Class="SinavSistemi.Egitmen.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Log Kayıtları" Style="{StaticResource H1}"/>
                <TextBlock Text="Bağlantı, dağıtım ve gönderim olaylarının tarih/saat kaydı" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="Yenile" Style="{StaticResource SecondaryButton}" Command="{Binding RefreshCommand}" Margin="0,0,10,0"/>
                <Button Content="Dosyaya kaydet" Style="{StaticResource SecondaryButton}" Command="{Binding ExportCommand}"/>
            </StackPanel>
        </Grid>

        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="160"/>
            </Grid.ColumnDefinitions>
            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Öğrenci no, IP veya mesajda ara"/>
            <ComboBox Grid.Column="1" Margin="12,0,0,0" ItemsSource="{Binding Levels}" SelectedItem="{Binding Level}"/>
        </Grid>

        <Border Style="{StaticResource Card}" Padding="0">
            <DataGrid ItemsSource="{Binding View}" FontFamily="{StaticResource CodeFont}" FontSize="12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ZAMAN" Binding="{Binding Time, StringFormat='dd.MM.yyyy HH:mm:ss'}" Width="160"/>
                    <DataGridTemplateColumn Header="SEVİYE" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Level, Converter={StaticResource EnumText}}" FontWeight="SemiBold"
                                           Foreground="{Binding Level, Converter={StaticResource StatusBrush}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="KAYNAK" Binding="{Binding Source}" Width="130"/>
                    <DataGridTextColumn Header="MESAJ" Binding="{Binding Message}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
