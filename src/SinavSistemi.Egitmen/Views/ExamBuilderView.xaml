<UserControl x:Class="SinavSistemi.Egitmen.Views.ExamBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <TextBlock Text="Sınav / Ödev Oluştur" Style="{StaticResource H1}"/>
            <TextBlock Text="Soru bankasından soru seçin, sırasını ve puanını belirleyin" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Ayarlar -->
        <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="140"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="BAŞLIK" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SINIF / ŞUBE" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding ClassName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="SÜRE (DAKİKA)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Alt çubuk -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="20,14" Margin="0,16,0,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource H2}">
                        <Run Text="{Binding QuestionCount, Mode=OneWay}"/> soru ·
                        <Run Text="{Binding TotalPoints, Mode=OneWay}"/> puan
                    </TextBlock>
                    <TextBlock Text="{Binding Error}" Foreground="{StaticResource DangerBrush}" Margin="20,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Temizle" Style="{StaticResource SecondaryButton}" Command="{Binding ClearCommand}" Margin="0,0,10,0"/>
                    <Button Content="Taslak kaydet" Style="{StaticResource SecondaryButton}" Command="{Binding SaveCommand}" Margin="0,0,10,0"/>
                    <Button Content="Kaydet ve dağıtıma geç →" Style="{StaticResource PrimaryButton}" Command="{Binding SaveAndDistributeCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Kodlama ağırlıkları (final) -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,16,0,0"
                Visibility="{Binding HasCodingQuestion, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Kodlama puanı:" Style="{StaticResource H2}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                <Slider Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                        Value="{Binding TestCaseWeight}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                    Test case %<Run Text="{Binding TestCaseWeight, Mode=OneWay}"/> · Karmaşıklık %<Run Text="{Binding ComplexityWeight, Mode=OneWay}"/>
                </TextBlock>
            </Grid>
        </Border>

        <!-- Banka | Seçilenler -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                        <TextBlock Text="Soru bankası" Style="{StaticResource H2}" Margin="0,0,0,10"/>
                        <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="Metin veya kategoriye göre ara"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding BankView}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="8,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}"/>
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding Type, Converter={StaticResource EnumText}, Mode=OneWay}"/> ·
                                            <Run Text="{Binding Category, Mode=OneWay}"/> ·
                                            <Run Text="{Binding DefaultPoints, Mode=OneWay}"/> p
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ekle" Style="{StaticResource SecondaryButton}" Padding="12,4" Margin="8,0,0,0"
                                            Command="{Binding DataContext.AddCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,16,16,10">
                        <TextBlock Text="Sınavdaki sorular" Style="{StaticResource H2}"/>
                        <TextBlock Text="Soldan ekleyin · puanı kutudan değiştirin · oklarla sıralayın" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Grid>
                        <ListBox ItemsSource="{Binding Selected}" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Order}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Question.Text}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Question.Type, Converter={StaticResource EnumText}}" Style="{StaticResource Caption}"/>
                                        </StackPanel>
                                        <TextBox Grid.Column="2" Text="{Binding Points, UpdateSourceTrigger=PropertyChanged}" Margin="8,0" Padding="4,4"
                                                 ToolTip="Puan" HorizontalContentAlignment="Center"/>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <Button Content="▲" Style="{StaticResource LinkButton}" ToolTip="Yukarı"
                                                    Command="{Binding DataContext.UpCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <Button Content="▼" Style="{StaticResource LinkButton}" ToolTip="Aşağı"
                                                    Command="{Binding DataContext.DownCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                            <Button Content="✕" Style="{StaticResource LinkButton}" Foreground="{StaticResource DangerBrush}" ToolTip="Çıkar"
                                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
