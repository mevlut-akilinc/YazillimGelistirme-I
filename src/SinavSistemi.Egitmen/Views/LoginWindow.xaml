<Window x:Class="SinavSistemi.Egitmen.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SinavSistemi.Egitmen.ViewModels"
        Title="Eğitmen Girişi — Lab Sınav Sistemi" Width="920" Height="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <Window.DataContext>
        <vm:LoginViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Background="{StaticResource SidebarBrush}">
            <Grid Margin="40">
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="{}{ }" FontFamily="{StaticResource CodeFont}" FontSize="28" Foreground="#2DD4BF" FontWeight="Bold"/>
                    <TextBlock Text="Lab Sınav Sistemi" FontSize="26" FontWeight="SemiBold" Foreground="White" Margin="0,16,0,0"/>
                    <TextBlock Text="EĞİTMEN · SUNUCU" FontSize="12" FontWeight="SemiBold" Foreground="#2DD4BF" Margin="0,8,0,0"/>
                    <TextBlock Text="Soru bankası, sınav dağıtımı ve sonuçlar. Bu bilgisayar öğrenciler için sunucu görevi görür."
                               Foreground="{StaticResource SidebarTextBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"/>
                </StackPanel>
                <TextBlock VerticalAlignment="Bottom" Foreground="#5E6B7A" FontSize="11"
                           Text="Kocaeli Üniversitesi · Yazılım Mühendisliği"/>
            </Grid>
        </Border>

        <StackPanel Grid.Column="1" Width="340" VerticalAlignment="Center">
            <TextBlock Text="Eğitmen girişi" Style="{StaticResource H1}"/>
            <TextBlock Text="Hesap bilgilerinizle giriş yapın." Style="{StaticResource Caption}" Margin="0,4,0,24"/>

            <TextBlock Text="KULLANICI ADI" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="UsernameBox" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14"/>

            <TextBlock Text="ŞİFRE" Style="{StaticResource FieldLabel}"/>
            <PasswordBox x:Name="PasswordBox" PasswordChanged="OnPasswordChanged" Margin="0,0,0,14"/>

            <Border Background="{StaticResource DangerSoftBrush}" CornerRadius="6" Padding="10,8" Margin="0,0,0,14"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"/>
            </Border>

            <Button Command="{Binding LoginCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="16,11">
                <Grid>
                    <TextBlock Text="Giriş yap" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                    <TextBlock Text="Kontrol ediliyor…" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </Button>

            <TextBlock Style="{StaticResource Caption}" Margin="0,16,0,0" Text="Demo: egitmen / 1234"/>
        </StackPanel>
    </Grid>
</Window>
