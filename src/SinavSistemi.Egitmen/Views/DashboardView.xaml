<UserControl x:Class="SinavSistemi.Egitmen.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock Text="Genel Bakış" Style="{StaticResource H1}"/>
            <TextBlock Text="Soru bankası, sınavlar ve sunucu durumu" Style="{StaticResource Caption}" Margin="0,4,0,24"/>

            <!-- Sayılar -->
            <UniformGrid Columns="4" Margin="0,0,-16,24">
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SORU BANKASI" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding QuestionCount}" Style="{StaticResource StatNumber}"/>
                        <TextBlock Style="{StaticResource Caption}">
                            <Run Text="{Binding McCount, Mode=OneWay}"/> ÇS ·
                            <Run Text="{Binding ClassicCount, Mode=OneWay}"/> klasik ·
                            <Run Text="{Binding CodeCount, Mode=OneWay}"/> kod
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SINAVLAR" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ExamCount}" Style="{StaticResource StatNumber}"/>
                        <TextBlock Text="taslak + yayınlanmış" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0">
                    <StackPanel>
                        <TextBlock Text="SUNUCU" Style="{StaticResource FieldLabel}"/>
                        <TextBlock Text="{Binding ServerStatus}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,8"
                                   Foreground="{StaticResource TextBrush}" TextWrapping="Wrap"/>
                        <Button Content="Canlı sınava git →" Style="{StaticResource LinkButton}" HorizontalAlignment="Left"
                                Padding="0" Command="{Binding GoCommand}" CommandParameter="live"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,16,0" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="HIZLI İŞLEM" Style="{StaticResource FieldLabel}"/>
                        <Button Content="+ Yeni soru" Style="{StaticResource PrimaryButton}" Margin="0,6,0,8"
                                Command="{Binding GoCommand}" CommandParameter="questions"/>
                        <Button Content="Sınav oluştur" Style="{StaticResource SecondaryButton}"
                                Command="{Binding GoCommand}" CommandParameter="builder"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Son sınavlar -->
            <Border Style="{StaticResource Card}" Padding="0">
                <StackPanel>
                    <TextBlock Text="Son sınavlar" Style="{StaticResource H2}" Margin="20,18,20,12"/>
                    <DataGrid ItemsSource="{Binding RecentExams}" MinHeight="120">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="BAŞLIK" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="SINIF" Binding="{Binding ClassName}" Width="90"/>
                            <DataGridTextColumn Header="SORU" Binding="{Binding Questions.Count}" Width="70"/>
                            <DataGridTextColumn Header="SÜRE (dk)" Binding="{Binding DurationMinutes}" Width="90"/>
                            <DataGridTemplateColumn Header="DURUM" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Badge}" Background="{Binding Status, Converter={StaticResource StatusBrush}}">
                                            <TextBlock Text="{Binding Status, Converter={StaticResource EnumText}}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
