<Project Sdk="Microsoft.NET.Sdk">

  <!-- İki exe'nin ortak kullandığı kütüphane: modeller, tema, mesaj protokolü, gcc çalıştırıcı -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SinavSistemi.Shared</RootNamespace>
    <AssemblyName>SinavSistemi.Shared</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

</Project>
