<Project Sdk="Microsoft.NET.Sdk">

  <!-- Ogrenci.exe: öğrenci bilgisayarlarında çalışır. Veritabanı/sunucu kodu İÇERMEZ. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
	  <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SinavSistemi.Ogrenci</RootNamespace>
    <AssemblyName>Ogrenci</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SinavSistemi.Shared\SinavSistemi.Shared.csproj" />
  </ItemGroup>

</Project>
