<Window x:Class="SinavSistemi.Ogrenci.Views.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Öğrenci — Lab Sınav Sistemi" Width="1280" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{StaticResource BgBrush}" FontFamily="{StaticResource UiFont}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource SidebarBrush}" Padding="24,12">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Lab Sınav" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="öğrenci" Foreground="{StaticResource SidebarTextBrush}" FontSize="13" Margin="8,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StudentLine}" Foreground="{StaticResource SidebarTextBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Content="Çıkış" Command="{Binding LogoutCommand}" Style="{StaticResource LinkButton}" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Content="{Binding CurrentPage}"/>
    </DockPanel>
</Window>
