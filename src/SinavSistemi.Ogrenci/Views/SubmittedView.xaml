<UserControl x:Class="SinavSistemi.Ogrenci.Views.SubmittedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Width="480" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <Border Width="56" Height="56" CornerRadius="28" Background="{StaticResource AccentSoftBrush}" Margin="0,0,0,20">
                <TextBlock Text="✓" FontSize="28" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Sınav teslim edildi" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding ExamTitle}" Style="{StaticResource Caption}" FontSize="14" HorizontalAlignment="Center" Margin="0,6,0,20"/>
            <TextBlock Text="{Binding Reason}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="{Binding Detail}" HorizontalAlignment="Center" Margin="0,6,0,0"/>
            <TextBlock Text="{Binding When}" Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,16,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
