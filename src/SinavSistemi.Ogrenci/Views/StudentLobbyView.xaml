<UserControl x:Class="SinavSistemi.Ogrenci.Views.StudentLobbyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Width="460" Padding="40" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel HorizontalAlignment="Center">
            <!-- Dönen halka -->
            <Grid Width="48" Height="48" Margin="0,0,0,24" RenderTransformOrigin="0.5,0.5">
                <Grid.RenderTransform>
                    <RotateTransform/>
                </Grid.RenderTransform>
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:1.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <Ellipse Stroke="{StaticResource LineBrush}" StrokeThickness="4"/>
                <Ellipse Stroke="{StaticResource AccentBrush}" StrokeThickness="4" StrokeDashArray="6 20"/>
            </Grid>

            <TextBlock Text="{Binding Greeting}" Style="{StaticResource H1}" HorizontalAlignment="Center"/>
            <TextBlock Text="Eğitmen bilgisayarına bağlandınız." Style="{StaticResource Caption}" FontSize="14"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Text="Sınav gönderildiğinde bu ekran otomatik olarak açılacak." Style="{StaticResource Caption}" FontSize="14"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
