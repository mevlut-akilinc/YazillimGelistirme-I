<UserControl x:Class="SinavSistemi.Ogrenci.Views.ExamSessionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Soru gezgini butonu: cevaplanan = dolu, aktif = çerçeveli -->
        <Style x:Key="NavDot" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsAnswered}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource TextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Üst bilgi çubuğu -->
        <Border DockPanel.Dock="Top" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,0,1" Padding="32,14">
            <Grid>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding ExamTitle}" Style="{StaticResource H2}"/>
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding ProgressText, Mode=OneWay}"/> · toplam <Run Text="{Binding TotalPoints, Mode=OneWay}"/> puan
                    </TextBlock>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border CornerRadius="6" Padding="14,6" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsTimeCritical}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Kalan" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding RemainingTime}" FontSize="20" FontWeight="SemiBold" FontFamily="{StaticResource CodeFont}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTimeCritical}" Value="True">
                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Button Content="Sınavı bitir ve gönder" Style="{StaticResource PrimaryButton}" Command="{Binding SubmitCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sol: soru gezgini -->
        <Border DockPanel.Dock="Left" Width="200" Padding="24,24,16,24">
            <StackPanel>
                <TextBlock Text="SORULAR" Style="{StaticResource FieldLabel}" Margin="0,0,0,10"/>
                <ItemsControl ItemsSource="{Binding Answers}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Number}" Style="{StaticResource NavDot}"
                                    Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,16,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource AccentBrush}" Margin="0,0,6,0"/>
                        <TextBlock Text="cevaplandı" Style="{StaticResource Caption}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="12" Height="12" CornerRadius="3" BorderBrush="{StaticResource LineBrush}" BorderThickness="2" Margin="0,0,6,0"/>
                        <TextBlock Text="boş" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Alt: önceki / sonraki -->
        <Grid DockPanel.Dock="Bottom" Margin="16,0,32,24">
            <Button Content="← Önceki" Style="{StaticResource SecondaryButton}" Command="{Binding PrevCommand}" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding PositionText}" Style="{StaticResource Caption}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="Sonraki →" Style="{StaticResource SecondaryButton}" Command="{Binding NextCommand}" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Aktif soru -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="16,24,32,16" IsEnabled="{Binding IsLocked, Converter={StaticResource Equals}, ConverterParameter=False}">
            <Border Style="{StaticResource Card}" Padding="28" DataContext="{Binding Current}" VerticalAlignment="Top">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Style="{StaticResource FieldLabel}" Margin="0">
                            SORU <Run Text="{Binding Number, Mode=OneWay}"/> · <Run Text="{Binding Points, Mode=OneWay}"/> PUAN
                        </TextBlock>
                        <Border Style="{StaticResource Badge}" Margin="12,0,0,0" Background="{Binding Question.Type, Converter={StaticResource StatusBrush}}">
                            <TextBlock Text="{Binding Question.Type, Converter={StaticResource EnumText}}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Text="{Binding Question.Text}" FontSize="17" TextWrapping="Wrap" LineHeight="26"
                               Foreground="{StaticResource TextBrush}" Margin="0,0,0,24"/>

                    <!-- Çoktan seçmeli -->
                    <ListBox ItemsSource="{Binding Question.Options}" SelectedItem="{Binding SelectedOption}"
                             ItemContainerStyle="{StaticResource OptionCard}" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Visibility="{Binding IsMultipleChoice, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" Width="28"/>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Klasik -->
                    <StackPanel Visibility="{Binding IsClassic, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="CEVABINIZ" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MinHeight="120" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>

                    <!-- Kodlama (final) -->
                    <StackPanel Visibility="{Binding IsCoding, Converter={StaticResource BoolToVis}}">
                        <Border CornerRadius="8" ClipToBounds="True" Background="{StaticResource CodeBgBrush}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="#2A2A2A" Padding="12,6">
                                    <Grid>
                                        <TextBlock Text="main.c" Foreground="#9CA3AF" FontFamily="{StaticResource CodeFont}" VerticalAlignment="Center"/>
                                        <Button HorizontalAlignment="Right" Style="{StaticResource PrimaryButton}" Padding="12,4"
                                                Command="{Binding RunCodeCommand}">
                                            <Grid>
                                                <TextBlock Text="▶ Derle ve test et" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}, ConverterParameter=Invert}"/>
                                                <TextBlock Text="Çalışıyor…" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}"/>
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>
                                <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource CodeEditor}" Height="320"/>
                            </DockPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16"
                                Visibility="{Binding RunResult, Converter={StaticResource NullToVis}}">
                            <StackPanel>
                                <TextBlock Text="{Binding TestSummary}" Style="{StaticResource H2}"/>
                                <TextBlock Text="{Binding ComplexitySummary}" Style="{StaticResource Caption}" FontSize="13" Margin="0,4,0,8"
                                           ToolTip="Sistem tarafından ölçülür; öğrenci değiştiremez"/>
                                <TextBlock Text="{Binding RunResult.CompilerOutput}" FontFamily="{StaticResource CodeFont}" FontSize="12"
                                           Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</UserControl>
